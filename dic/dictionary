<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>한빈쌤 영어 표현 사전</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-sub: #f1f5f9;
      --text: #0f172a;
      --text-sub: #64748b;
      --border: #e2e8f0;
      --primary: #2563eb;
      --primary-soft: #eff6ff;
      --yt: #ef4444;
      --yt-soft: #fef2f2;
      --success: #10b981;
      --success-soft: #ecfdf5;
      --radius: 14px;
      --font: 'Pretendard', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    }



    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
    }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    button, a {
      font-family: inherit;
      white-space: nowrap;
      flex-shrink: 0;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
    }

    .header-bar {
      max-width: 760px;
      margin: 0 auto;
      height: 56px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: inherit;
      min-width: 0;
    }

    .brand-logo {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: #ef4444;
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      white-space: nowrap;
    }

    .count-chip {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--primary-soft);
      color: var(--primary);
      white-space: nowrap;
    }

    .header-controls {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .mode-group {
      display: inline-flex;
      background: var(--surface-sub);
      padding: 3px;
      border-radius: 10px;
    }

    .mode-btn {
      height: 30px;
      padding: 0 10px;
      border: none;
      border-radius: 7px;
      background: transparent;
      color: var(--text-sub);
      font-size: 0.8rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .mode-btn.active {
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }

    .icon-btn {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-sub);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
      text-decoration: none;
    }

    .icon-btn:hover {
      color: var(--text);
      background: var(--surface-sub);
    }

    /* Main */
    main {
      max-width: 760px;
      width: 100%;
      margin: 0 auto;
      padding: 14px 14px 40px;
      flex: 1;
    }

    /* Toolbar */
    .toolbar {
      position: relative;
      z-index: 10;
      background: var(--bg);
      padding: 0 0 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .search-box {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 13px;
      color: var(--text-sub);
      pointer-events: none;
      display: flex;
    }

    .search-input {
      width: 100%;
      height: 42px;
      padding: 0 38px 0 38px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 0.92rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s ease;
    }

    .search-input:focus {
      border-color: var(--primary);
    }

    .clear-btn {
      position: absolute;
      right: 8px;
      width: 28px;
      height: 28px;
      border: none;
      border-radius: 7px;
      background: transparent;
      color: var(--text-sub);
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .clear-btn.visible {
      display: inline-flex;
    }

    .filter-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .filter-pills {
      display: flex;
      align-items: center;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .filter-pills::-webkit-scrollbar {
      display: none;
    }

    .pill {
      height: 32px;
      padding: 0 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-sub);
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .pill.active {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
    }

    /* Expression Cards */
    .card-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .expr-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: border-color 0.15s ease;
    }

    .expr-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .expr-main {
      min-width: 0;
      flex: 1;
    }

    .expr-meta-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 3px;
    }

    .num-tag {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-sub);
      background: var(--surface-sub);
      padding: 1px 7px;
      border-radius: 6px;
    }

    .expr-en {
      font-size: 1.08rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.01em;
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .expr-ko {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--primary);
      margin-top: 2px;
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .expr-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .yt-btn {
      height: 34px;
      padding: 0 11px;
      border-radius: 9px;
      background: var(--yt-soft);
      color: var(--yt);
      border: 1px solid rgba(239, 68, 68, 0.25);
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: transform 0.12s ease, background 0.15s ease;
    }

    .yt-btn:hover {
      background: var(--yt);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .check-btn {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-sub);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .check-btn.done {
      background: var(--success-soft);
      border-color: var(--success);
      color: var(--success);
    }

    .expr-examples {
      background: var(--surface-sub);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 0.85rem;
      color: var(--text);
      white-space: pre-line;
      word-break: break-word;
      overflow-wrap: anywhere;
      line-height: 1.55;
      max-width: 100%;
    }

    /* Empty State */
    .empty-box {
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      padding: 40px 16px;
      text-align: center;
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .empty-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-sub);
    }

    /* Study Mode (Flip Card) */
    .study-view {
      display: none;
      flex-direction: column;
      gap: 14px;
      max-width: 540px;
      margin: 8px auto 0;
    }

    .study-view.active {
      display: flex;
    }

    .progress-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-sub);
    }

    .progress-track {
      width: 100%;
      height: 6px;
      background: var(--surface-sub);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--primary);
      width: 0%;
      transition: width 0.25s ease;
    }

    .flipcard {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 20px;
      min-height: 310px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
      transition: border-color 0.15s ease;
    }

    .flipcard:hover {
      border-color: var(--primary);
    }

    .flip-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .flip-body {
      margin: 24px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 14px;
    }

    .flip-ko {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--primary);
      line-height: 1.4;
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
      max-width: 100%;
    }

    .flip-en {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1.3;
      transition: filter 0.25s ease, opacity 0.25s ease;
      padding: 4px 10px;
      white-space: normal;
      word-break: break-word;
      overflow-wrap: anywhere;
      max-width: 100%;
    }

    .flip-en.blurred {
      filter: blur(11px);
      opacity: 0.55;
    }

    .flip-hint {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-sub);
      background: var(--surface-sub);
      padding: 4px 12px;
      border-radius: 999px;
    }

    .flip-examples {
      width: 100%;
      background: var(--surface-sub);
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 0.86rem;
      text-align: left;
      white-space: pre-line;
      line-height: 1.55;
    }

    .flip-examples.hidden {
      display: none;
    }

    .study-nav {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .nav-btn {
      height: 44px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 0.85rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .nav-btn:hover {
      background: var(--surface-sub);
    }

    .nav-btn.primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #ffffff;
    }

    .nav-btn.done {
      background: var(--success-soft);
      border-color: var(--success);
      color: var(--success);
    }

        /* Video Modal */
    .video-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      width: 100%;
      max-width: 380px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.35);
    }

    .video-head {
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border-bottom: 1px solid var(--border);
    }

    .engine-tabs {
      display: inline-flex;
      background: var(--surface-sub);
      padding: 2px;
      border-radius: 8px;
      gap: 2px;
    }

    .engine-btn {
      height: 26px;
      padding: 0 9px;
      border: none;
      border-radius: 6px;
      background: transparent;
      color: var(--text-sub);
      font-size: 0.74rem;
      font-weight: 700;
      cursor: pointer;
    }

    .engine-btn.active {
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }

    .video-frame-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 9 / 16;
      max-height: 62vh;
      background: #000000;
    }

    .video-frame-wrap iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    .video-foot {
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border-top: 1px solid var(--border);
      background: var(--surface);
    }

    .video-expr-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
      flex: 1;
    }

    .video-foot-btns {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    /* Data Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      z-index: 60;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      width: 100%;
      max-width: 440px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-title {
      font-size: 0.98rem;
      font-weight: 800;
    }

    .modal-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .action-btn {
      height: 36px;
      padding: 0 12px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--surface-sub);
      color: var(--text);
      font-size: 0.8rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: #0f172a;
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
      z-index: 100;
      display: none;
      white-space: nowrap;
    }

    .teacher-tabs {
      display: inline-flex;
      background: var(--surface-sub);
      padding: 3px;
      border-radius: 10px;
      gap: 2px;
    }
    .teacher-tab {
      height: 32px;
      padding: 0 10px;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--text-sub);
      font-size: 0.81rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .teacher-tab.active {
      background: var(--surface);
      color: var(--text);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }
    .tan-select {
      height: 32px;
      padding: 0 8px;
      border-radius: 9px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-size: 0.79rem;
      font-weight: 600;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      max-width: 145px;
      flex-shrink: 0;
    }
    .time-chip {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-soft);
      padding: 1px 7px;
      border-radius: 6px;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .num-tag.hb-tag {
      background: #eef2ff;
      color: #4338ca;
    }
    .num-tag.gs-tag {
      background: #f0fdf4;
      color: #15803d;
    }
    .video-box.wide {
      max-width: 560px;
    }
    .video-frame-wrap.wide {
      aspect-ratio: 16 / 9;
    }

    @media (max-width: 480px) {
      .header-bar {
        padding: 0 12px;
      }
      main {
        padding: 8px 12px 32px;
      }
      .expr-card {
        padding: 12px 14px;
      }
      .expr-en {
        font-size: 1.04rem;
      }
      .flip-en {
        font-size: 1.35rem;
      }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-bar">
      <div style="display:inline-flex;align-items:center;gap:6px;">
        <a href="javascript:void(0)" class="brand" id="brand-top" style="display:none;"><span id="total-badge" class="count-chip">0</span></a>
        <div class="teacher-tabs" role="tablist" aria-label="선생님 선택">
          <button type="button" id="tab-hanbin" class="teacher-tab active" role="tab" aria-selected="true">
            <span>한빈쌤</span>
            <span id="hanbin-badge" class="count-chip">105</span>
          </button>
          <button type="button" id="tab-guseul" class="teacher-tab" role="tab" aria-selected="false">
            <span>구슬쌤</span>
            <span id="guseul-badge" class="count-chip">2544</span>
          </button>
        </div>
      </div>

      <div class="header-controls">
        <div class="mode-group" role="tablist">
          <button type="button" id="mode-list-btn" class="mode-btn active" role="tab" aria-selected="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>목록</span>
          </button>
          <button type="button" id="mode-card-btn" class="mode-btn" role="tab" aria-selected="false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            <span>카드</span>
          </button>
        </div>

        <a href="https://www.youtube.com/@hanbin_ssam/shorts" target="_blank" rel="noopener noreferrer" class="icon-btn" title="한빈쌤 Shorts 채널 열기" aria-label="한빈쌤 Shorts 채널 열기">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>

        <button type="button" id="open-data-btn" class="icon-btn" title="데이터 추가 및 백업" aria-label="데이터 추가 및 백업">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>


      </div>
    </div>
  </header>

  <main>
    <!-- List Mode Toolbar -->
    <div id="list-toolbar" class="toolbar">
      <div class="search-box">
        <span class="search-icon">
