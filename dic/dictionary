        return `https://cdn.embedly.com/widgets/media.html?src=${embedUrl}&display_name=YouTube&url=${watchUrl}&key=a19fcc184b9711e1b4764040d3dc5c07&type=text%2Fhtml&schema=youtube&autoplay=1`;
      } else {
        return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&playsinline=1&enablejsapi=1&rel=0${startParam}&origin=https://www.youtube.com&widget_referrer=https://www.youtube.com`;
      }
    }

    function nudgeYouTubeAutoplay() {
      const frame = document.getElementById('yt-player-frame');
      if (!frame || !frame.contentWindow) return;
      try {
        frame.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo', args: [] }), '*');
      } catch (e) {}
    }

    function openVideoPlayer(videoId, itemObj, teacherOverride) {
      if (!videoId) return;
      const itemTeacher = teacherOverride || (itemObj && itemObj._teacher) || currentTeacher;
      activeVideoId = videoId;
      activeVideoTeacher = itemTeacher;
      activeStartSec = itemObj && Number(itemObj.seconds) > 0 ? Math.floor(Number(itemObj.seconds)) : 0;

      const modal = document.getElementById('video-modal');
      const box = document.getElementById('video-box-container');
      const wrap = document.getElementById('video-frame-wrap');
      const frame = document.getElementById('yt-player-frame');
      const label = document.getElementById('video-expr-label');
      const extLink = document.getElementById('ext-video-app-link');

      const isWide = itemTeacher === 'guseul';
      if (box) box.classList.toggle('wide', isWide);
      if (wrap) wrap.classList.toggle('wide', isWide);

      frame.src = buildEmbedSrc(videoId, activeEngine, activeStartSec);
      if (label) {
        const timeStr = itemObj && itemObj.timeline ? ` (${itemObj.timeline})` : '';
        const prefix = itemTeacher === 'hanbin' ? '[한빈쌤] ' : '[구슬쌤] ';
        label.textContent = itemObj ? `${prefix}#${itemObj.id} ${itemObj.en}${timeStr}` : videoId;
      }
      if (extLink) {
        extLink.href = activeStartSec > 0
          ? `https://www.youtube.com/watch?v=${videoId}&t=${activeStartSec}s`
          : (itemTeacher === 'hanbin' ? `https://www.youtube.com/shorts/${videoId}` : `https://www.youtube.com/watch?v=${videoId}`);
      }
      modal.classList.add('active');
      setTimeout(nudgeYouTubeAutoplay, 250);
      setTimeout(nudgeYouTubeAutoplay, 700);
    }

    function closeVideoPlayer() {
      const modal = document.getElementById('video-modal');
      const frame = document.getElementById('yt-player-frame');
      if (frame) frame.src = 'about:blank';
      if (modal) modal.classList.remove('active');
    }

    function copyText(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('유튜브 링크가 복사되었습니다');
        }).catch(() => fallbackCopyText(text));
      } else {
        fallbackCopyText(text);
      }
    }

    function fallbackCopyText(text) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        showToast('유튜브 링크가 복사되었습니다');
      } catch (e) {
        showToast(text);
      }
      document.body.removeChild(ta);
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      clearTimeout(t._timer);
      t._timer = setTimeout(() => {
        t.style.display = 'none';
      }, 2000);
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function populateTanSelect() {
      const sel = document.getElementById('tan-select');
      if (!sel) return;
      const counts = {};
      guseulItems.forEach(it => {
        const t = it.tan || 1;
        counts[t] = (counts[t] || 0) + 1;
      });
      let opts = `<option value="all">전체 (${guseulItems.length})</option>`;
      Object.keys(counts).sort((a, b) => Number(a) - Number(b)).forEach(t => {
        const label = Number(t) === 51 ? `전화영어 (${counts[t]})` : `${t}탄 (${counts[t]})`;
        opts += `<option value="${t}">${label}</option>`;
      });
      sel.innerHTML = opts;
      sel.value = currentTan;
    }

    function matchesQuery(it, q) {
      if (!q) return true;
      return (
        (it.en && it.en.toLowerCase().includes(q)) ||
        (it.ko && it.ko.toLowerCase().includes(q)) ||
        (it.examples && it.examples.toLowerCase().includes(q)) ||
        String(it.id).includes(q)
      );
    }

    function getFilteredItems() {
      const q = searchQuery.trim().toLowerCase();
      // When searching, unify search across BOTH Hanbin-ssam and Gu-seul ssam!
      if (q) {
        const combined = [];
        hanbinItems.forEach(it => {
          const isMem = memHanbin.has(it.id);
          if (currentFilter === 'unmemorized' && isMem) return;
          if (currentFilter === 'memorized' && !isMem) return;
          if (matchesQuery(it, q)) {
            combined.push(Object.assign({}, it, { _teacher: 'hanbin' }));
          }
        });
        guseulItems.forEach(it => {
          const isMem = memGuseul.has(it.id);
          if (currentFilter === 'unmemorized' && isMem) return;
          if (currentFilter === 'memorized' && !isMem) return;
          if (matchesQuery(it, q)) {
            combined.push(Object.assign({}, it, { _teacher: 'guseul' }));
          }
        });
        return combined;
      }

      const items = getActiveItems();
      const memorized = getActiveMemSet();
      return items.filter(it => {
        if (currentTeacher === 'guseul' && currentTan !== 'all') {
          if (String(it.tan) !== String(currentTan)) return false;
        }
        const isMem = memorized.has(it.id);
        if (currentFilter === 'unmemorized' && isMem) return false;
        if (currentFilter === 'memorized' && !isMem) return false;
        return true;
      }).map(it => Object.assign({}, it, { _teacher: currentTeacher }));
    }

    function updateCounts() {
      const items = getActiveItems();
      const memorized = getActiveMemSet();
      document.getElementById('hanbin-badge').textContent = hanbinItems.length;
      document.getElementById('guseul-badge').textContent = guseulItems.length;
      document.getElementById('total-badge').textContent = items.length;

      const q = searchQuery.trim().toLowerCase();
      if (q) {
        const hbMatches = hanbinItems.filter(it => matchesQuery(it, q));
        const gsMatches = guseulItems.filter(it => matchesQuery(it, q));
        const totalMatches = hbMatches.length + gsMatches.length;
        const memCount = hbMatches.filter(it => memHanbin.has(it.id)).length + gsMatches.filter(it => memGuseul.has(it.id)).length;
        const unmemCount = totalMatches - memCount;
        document.getElementById('pill-all').textContent = `통합검색 ${totalMatches}`;
        document.getElementById('pill-unmem').textContent = `미암기 ${unmemCount}`;
        document.getElementById('pill-mem').textContent = `암기완료 ${memCount}`;
        return;
      }

      let pool = items;
      if (currentTeacher === 'guseul' && currentTan !== 'all') {
        pool = items.filter(it => String(it.tan) === String(currentTan));
      }
      const memCount = pool.filter(it => memorized.has(it.id)).length;
      const unmemCount = pool.length - memCount;

      document.getElementById('pill-all').textContent = `전체 ${pool.length}`;
      document.getElementById('pill-unmem').textContent = `미암기 ${unmemCount}`;
      document.getElementById('pill-mem').textContent = `암기완료 ${memCount}`;
    }

    function renderList() {
      updateCounts();
      const filtered = getFilteredItems();
      const listEl = document.getElementById('card-list');
      const emptyEl = document.getElementById('empty-box');
      const isSearching = searchQuery.trim().length > 0;

      if (filtered.length === 0) {
        listEl.innerHTML = '';
        emptyEl.style.display = 'flex';
        return;
      }

      emptyEl.style.display = 'none';
      const renderSlice = filtered.slice(0, 250);
      listEl.innerHTML = renderSlice.map(it => {
        const itemTeacher = it._teacher || currentTeacher;
        const memSet = getMemSetForTeacher(itemTeacher);
        const isDone = memSet.has(it.id);

        let tanLabel = '';
        let tagClass = 'num-tag';
        if (itemTeacher === 'guseul') {
          const epStr = it.tan === 51 ? '전화영어' : `${it.tan || 1}탄`;
          tanLabel = isSearching ? `구슬쌤 ${epStr} · #${it.id}` : `${epStr} · #${it.id}`;
          if (isSearching) tagClass += ' gs-tag';
        } else {
          tanLabel = isSearching ? `한빈쌤 · #${it.id}` : `#${it.id}`;
          if (isSearching) tagClass += ' hb-tag';
        }

        const timeBadge = (itemTeacher === 'guseul' && it.timeline)
          ? `<button type="button" class="time-chip" data-video-id="${it.video_id}" data-item-id="${it.id}" data-teacher="${itemTeacher}" title="${it.timeline} 구간 바로 재생">⏱ ${escapeHtml(it.timeline)}</button>`
          : '';
        return `
          <article class="expr-card">
            <div class="expr-top">
              <div class="expr-main">
                <div class="expr-meta-row">
                  <span class="${tagClass}">${tanLabel}</span>
                  ${timeBadge}
                </div>
                <div class="expr-en">${escapeHtml(it.en)}</div>
                <div class="expr-ko">${escapeHtml(it.ko)}</div>
              </div>
              <div class="expr-actions">
                <button type="button" class="yt-btn" data-video-id="${it.video_id}" data-item-id="${it.id}" data-teacher="${itemTeacher}" title="유튜브 영상 즉시 재생">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  <span>영상</span>
                </button>
                <button type="button" class="check-btn ${isDone ? 'done' : ''}" data-id="${it.id}" data-teacher="${itemTeacher}" title="암기 표시" aria-label="암기 표시">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </div>
            </div>
            ${it.examples ? `<div class="expr-examples">${escapeHtml(it.examples)}</div>` : ''}
          </article>
        `;
      }).join('');

      listEl.querySelectorAll('.yt-btn[data-video-id], .time-chip[data-video-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const vid = btn.getAttribute('data-video-id');
          const id = Number(btn.getAttribute('data-item-id'));
          const tchr = btn.getAttribute('data-teacher') || currentTeacher;
          const sourceArr = tchr === 'hanbin' ? hanbinItems : guseulItems;
          const found = sourceArr.find(x => x.id === id);
          openVideoPlayer(vid, found, tchr);
        });
      });

      listEl.querySelectorAll('.check-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = Number(btn.getAttribute('data-id'));
          const tchr = btn.getAttribute('data-teacher') || currentTeacher;
          const memSet = getMemSetForTeacher(tchr);
          if (memSet.has(id)) {
            memSet.delete(id);
          } else {
            memSet.add(id);
          }
          saveMemSetForTeacher(tchr);
          renderList();
        });
      });
    }

    function getStudyPool() {
      const filtered = getFilteredItems();
      return filtered.length > 0 ? filtered : getActiveItems().map(it => Object.assign({}, it, { _teacher: currentTeacher }));
    }

    function renderStudy() {
      const pool = getStudyPool();
      if (pool.length === 0) return;
      if (studyIdx >= pool.length) studyIdx = 0;
      if (studyIdx < 0) studyIdx = pool.length - 1;

      const it = pool[studyIdx];
      const itemTeacher = it._teacher || currentTeacher;
      const memorized = getMemSetForTeacher(itemTeacher);
      const isDone = memorized.has(it.id);

      document.getElementById('study-pos').textContent = `${studyIdx + 1} / ${pool.length}`;
      const memCount = pool.filter(x => getMemSetForTeacher(x._teacher || currentTeacher).has(x.id)).length;
      document.getElementById('study-mem-count').textContent = `암기 ${memCount}`;
      document.getElementById('study-bar').style.width = `${((studyIdx + 1) / pool.length) * 100}%`;

      const tanLabel = itemTeacher === 'guseul' && it.tan
        ? (it.tan === 51 ? `구슬쌤 전화영어 · #${it.id}` : `구슬쌤 ${it.tan}탄 · #${it.id}`)
        : `한빈쌤 · #${it.id}`;
      const timeSuffix = (itemTeacher === 'guseul' && it.timeline) ? ` · ⏱ ${it.timeline}` : '';
      document.getElementById('flip-num').textContent = `${tanLabel}${timeSuffix}`;
      document.getElementById('flip-yt-link').setAttribute('data-video-id', it.video_id);
      document.getElementById('flip-ko').textContent = it.ko;

      const enEl = document.getElementById('flip-en');
      const hintEl = document.getElementById('flip-hint');
      const exEl = document.getElementById('flip-examples');

      enEl.textContent = it.en;
      exEl.textContent = it.examples || '';

      if (revealed) {
        enEl.classList.remove('blurred');
        hintEl.textContent = '탭하여 가리기';
        if (it.examples) exEl.classList.remove('hidden');
      } else {
        enEl.classList.add('blurred');
        hintEl.textContent = '탭하여 정답 보기';
        exEl.classList.add('hidden');
      }

      const memBtn = document.getElementById('mem-btn');
      if (isDone) {
        memBtn.classList.add('done');
      } else {
        memBtn.classList.remove('done');
      }
    }

    function setTeacher(teacher) {
      currentTeacher = teacher;
      const isHb = teacher === 'hanbin';
      document.getElementById('tab-hanbin').classList.toggle('active', isHb);
      document.getElementById('tab-hanbin').setAttribute('aria-selected', isHb);
      document.getElementById('tab-guseul').classList.toggle('active', !isHb);
      document.getElementById('tab-guseul').setAttribute('aria-selected', !isHb);

      const tanSel = document.getElementById('tan-select');
      if (tanSel) {
        tanSel.style.display = isHb ? 'none' : 'inline-block';
      }
      studyIdx = 0;
      revealed = false;
      renderList();
      renderStudy();
    }

    function setMode(mode) {
      currentMode = mode;
      const listToolbar = document.getElementById('list-toolbar');
      const cardList = document.getElementById('card-list');
      const emptyBox = document.getElementById('empty-box');
      const studyView = document.getElementById('study-view');
      const btnList = document.getElementById('mode-list-btn');
      const btnCard = document.getElementById('mode-card-btn');

      if (mode === 'list') {
        btnList.classList.add('active');
        btnCard.classList.remove('active');
        listToolbar.style.display = 'flex';
        cardList.style.display = 'flex';
        studyView.classList.remove('active');
        renderList();
      } else {
        btnCard.classList.add('active');
        btnList.classList.remove('active');
        listToolbar.style.display = 'none';
        cardList.style.display = 'none';
        emptyBox.style.display = 'none';
        studyView.classList.add('active');
        revealed = false;
        renderStudy();
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.body.classList.remove('dark');
      populateTanSelect();

      document.getElementById('tab-hanbin').addEventListener('click', () => setTeacher('hanbin'));
      document.getElementById('tab-guseul').addEventListener('click', () => setTeacher('guseul'));

      document.getElementById('tan-select').addEventListener('change', (e) => {
        currentTan = e.target.value;
        studyIdx = 0;
        renderList();
        renderStudy();
      });

      document.getElementById('mode-list-btn').addEventListener('click', () => setMode('list'));
      document.getElementById('mode-card-btn').addEventListener('click', () => setMode('card'));
      document.getElementById('brand-top').addEventListener('click', () => setMode('list'));

      const sInput = document.getElementById('search-input');
      const sClear = document.getElementById('search-clear');
      sInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        sClear.style.display = searchQuery ? 'inline-flex' : 'none';
        renderList();
      });
      sClear.addEventListener('click', () => {
        searchQuery = '';
        sInput.value = '';
        sClear.style.display = 'none';
        renderList();
      });

      document.querySelectorAll('.pill').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.pill').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.getAttribute('data-filter');
          renderList();
        });
      });

      document.getElementById('reset-search-btn').addEventListener('click', () => {
        searchQuery = '';
        sInput.value = '';
        sClear.style.display = 'none';
        currentFilter = 'all';
        currentTan = 'all';
        document.getElementById('tan-select').value = 'all';
        document.querySelectorAll('.pill').forEach(b => b.classList.remove('active'));
        document.getElementById('pill-all').classList.add('active');
        renderList();
      });

      const vModal = document.getElementById('video-modal');
      const ytFrame = document.getElementById('yt-player-frame');
      ytFrame.addEventListener('load', () => {
        nudgeYouTubeAutoplay();
        setTimeout(nudgeYouTubeAutoplay, 300);
      });

      document.getElementById('close-video-btn').addEventListener('click', closeVideoPlayer);
      vModal.addEventListener('click', (e) => {
        if (e.target === vModal) closeVideoPlayer();
      });

      document.getElementById('engine-relay-btn').addEventListener('click', () => {
        activeEngine = 'relay';
        document.getElementById('engine-relay-btn').classList.add('active');
        document.getElementById('engine-direct-btn').classList.remove('active');
        if (activeVideoId) {
          ytFrame.src = buildEmbedSrc(activeVideoId, 'relay', activeStartSec);
        }
      });

      document.getElementById('engine-direct-btn').addEventListener('click', () => {
        activeEngine = 'direct';
        document.getElementById('engine-direct-btn').classList.add('active');
        document.getElementById('engine-relay-btn').classList.remove('active');
        if (activeVideoId) {
          ytFrame.src = buildEmbedSrc(activeVideoId, 'direct', activeStartSec);
        }
      });

      document.getElementById('copy-video-url-btn').addEventListener('click', () => {
        if (activeVideoId) {
          const url = activeStartSec > 0
            ? `https://www.youtube.com/watch?v=${activeVideoId}&t=${activeStartSec}s`
            : (activeVideoTeacher === 'hanbin' ? `https://www.youtube.com/shorts/${activeVideoId}` : `https://www.youtube.com/watch?v=${activeVideoId}`);
          copyText(url);
        }
      });

      document.getElementById('flip-yt-link').addEventListener('click', (e) => {
        e.stopPropagation();
        const pool = getStudyPool();
        const it = pool[studyIdx];
        if (it) openVideoPlayer(it.video_id, it, it._teacher || currentTeacher);
      });

      const flipcard = document.getElementById('flipcard');
      flipcard.addEventListener('click', (e) => {
        if (e.target.closest('#flip-yt-link')) return;
        revealed = !revealed;
        renderStudy();
      });
      document.getElementById('prev-btn').addEventListener('click', () => {
        const pool = getStudyPool();
        studyIdx = (studyIdx - 1 + pool.length) % pool.length;
        revealed = false;
        renderStudy();
      });
      document.getElementById('next-btn').addEventListener('click', () => {
        const pool = getStudyPool();
        studyIdx = (studyIdx + 1) % pool.length;
        revealed = false;
        renderStudy();
      });
      document.getElementById('random-btn').addEventListener('click', () => {
        const pool = getStudyPool();
        if (pool.length <= 1) return;
        let next = studyIdx;
        while (next === studyIdx) {
          next = Math.floor(Math.random() * pool.length);
        }
        studyIdx = next;
        revealed = false;
        renderStudy();
      });
      document.getElementById('mem-btn').addEventListener('click', () => {
        const pool = getStudyPool();
        const it = pool[studyIdx];
        if (!it) return;
        const tchr = it._teacher || currentTeacher;
        const memSet = getMemSetForTeacher(tchr);
        if (memSet.has(it.id)) {
          memSet.delete(it.id);
        } else {
          memSet.add(id => it.id);
          memSet.add(it.id);
        }
        saveMemSetForTeacher(tchr);
        renderStudy();
      });

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeVideoPlayer();
          document.getElementById('data-modal').classList.remove('active');
          return;
        }
        if (currentMode !== 'card') return;
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT') return;
        const pool = getStudyPool();
        if (e.key === 'ArrowRight') {
          studyIdx = (studyIdx + 1) % pool.length;
          revealed = false;
          renderStudy();
        } else if (e.key === 'ArrowLeft') {
          studyIdx = (studyIdx - 1 + pool.length) % pool.length;
          revealed = false;
          renderStudy();
        } else if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          revealed = !revealed;
          renderStudy();
        }
      });

      const dModal = document.getElementById('data-modal');
      document.getElementById('open-data-btn').addEventListener('click', () => dModal.classList.add('active'));
      document.getElementById('close-data-btn').addEventListener('click', () => dModal.classList.remove('active'));
      dModal.addEventListener('click', (e) => {
        if (e.target === dModal) dModal.classList.remove('active');
      });

      document.getElementById('export-btn').addEventListener('click', () => {
        const payload = { hanbin: hanbinItems, guseul: guseulItems };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'english_expressions_backup.json';
        a.click();
        URL.revokeObjectURL(url);
      });

      document.getElementById('reset-data-btn').addEventListener('click', () => {
        hanbinItems = JSON.parse(JSON.stringify(INITIAL_ITEMS));
        guseulItems = JSON.parse(JSON.stringify(INITIAL_GUSEUL));
        store.set('hanbin_dict_items_v2', hanbinItems);
        store.set('guseul_dict_items_v3', guseulItems);
        populateTanSelect();
        renderList();
        renderStudy();
        dModal.classList.remove('active');
        showToast('초기 데이터로 복원되었습니다.');
      });

      document.getElementById('json-input').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          try {
            const parsed = JSON.parse(ev.target.result);
            if (Array.isArray(parsed)) {
              const target = getActiveItems();
              const map = new Map();
              target.forEach(x => map.set(x.id, x));
              let added = 0;
              parsed.forEach(x => {
                if (x && x.en && !map.has(x.id)) {
                  map.set(x.id || (map.size + 1), x);
                  added++;
                }
              });
              const updated = Array.from(map.values()).sort((a, b) => a.id - b.id);
              if (currentTeacher === 'hanbin') {
                hanbinItems = updated;
                store.set('hanbin_dict_items_v2', hanbinItems);
              } else {
                guseulItems = updated;
                store.set('guseul_dict_items_v3', guseulItems);
                populateTanSelect();
              }
              renderList();
              renderStudy();
              dModal.classList.remove('active');
              showToast(`${added}개 표현 추가 완료`);
            }
          } catch (err) {
            showToast('JSON 형식을 확인해 주세요.');
          }
        };
        reader.readAsText(file);
      });

      renderList();
    });
